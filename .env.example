# ============================================================================
# Smart Connects — environment template
# Copy this file to .env and fill in real values. .env is gitignored.
# ============================================================================

# ─── Email (OTP / verification codes) ───
# Option A (recommended): Resend — https://resend.com → API Keys
#   NOTE: with FROM_EMAIL=onboarding@resend.dev Resend only delivers to the
#   email that owns the Resend account. To send to ANY email address, verify
#   your own domain at resend.com/domains and set FROM_EMAIL to it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev

# Option B (fallback): Gmail SMTP — needs a Google App Password
#   https://myaccount.google.com/apppasswords (16 chars, spaces are stripped automatically)
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ─── Other ───
JWT_SECRET=change-me-in-production
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:3000
