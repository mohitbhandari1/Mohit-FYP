# ─── Server ───
PORT=4000

# ─── Database (PostgreSQL) ───
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=smart_connects

# ─── JWT Secret ───
JWT_SECRET=your-secret-key-here

# ─── Email (Resend) ───
# To send real welcome/notification emails:
#   1. Sign up at https://resend.com (free tier: 100 emails/day)
#   2. Verify a domain (e.g., yourdomain.com) in the Resend dashboard
#   3. Create an API key in the Resend dashboard
#   4. Fill in RESEND_API_KEY and FROM_EMAIL below
#
# Leave RESEND_API_KEY empty to use dev mode (emails are logged to console only).
RESEND_API_KEY=
FROM_EMAIL=notifications@smartconnects.com
